# Copy to deploy/.env.production on the server and fill in. Never commit the filled-in file.

# The address of this API (a DNS A record must point it at the server), no https:// in front
API_DOMAIN=api.yourdomain.com

# Production guardrails (the app refuses to start without email and ALLOWED_ORIGINS)
APP_ENV=production
ALLOWED_ORIGINS=
TRUST_PROXY=1
FORCE_SECURE_COOKIES=1

# Nebius Token Factory
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
COACH_MODEL=nvidia/nemotron-3-super-120b-a12b
SUMMARY_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
VISION_MODEL=google/gemma-3-27b-it

# Email for sign-up codes (Gmail: use an App password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Email through Brevo's web API (works where SMTP is blocked, e.g. Render's free tier). Leave empty to use the SMTP values above.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=RepSight

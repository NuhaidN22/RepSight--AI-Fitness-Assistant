NEBIUS_API_KEY=your_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
COACH_MODEL=nvidia/nemotron-3-super-120b-a12b
SUMMARY_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
VISION_MODEL=
# Email for sign-up codes. Leave empty while developing: the code is then printed in the backend terminal instead.
# Gmail: turn on 2-step verification, create an "App password", and use it below (never your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Public deployment only (leave out for local use) ----
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require   # Neon (free Postgres). Empty = local SQLite file
# MAIL_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec   # web mail relay for hosts that block SMTP (see deploy/mail-relay.gs)
# MAIL_WEBHOOK_SECRET=a-long-random-text-of-at-least-30-characters
# LOGOUT_ON_START=0             # keep logins when the host puts the app to sleep and wakes it (Render free). Default 1: a restart logs everyone out
# MAX_IMAGE_MB=6                # photo size cap (default 6 on Postgres, 10 on SQLite)
# APP_ENV=production            # refuses to start without working email
# ALLOWED_ORIGINS=https://repsight.vercel.app   # your public web address(es), comma-separated
# TRUST_PROXY=cloudflare        # Render and a Cloudflare tunnel: use the visitor address Cloudflare supplies (use 1 behind your own proxy)
# FORCE_SECURE_COOKIES=1        # login cookie is only sent over https
# REPSIGHT_DB=/data/app.db      # keep the database and photos on a disk that survives restarts
# REPSIGHT_UPLOADS=/data/uploads
